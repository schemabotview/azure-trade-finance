{
  "parameters": [
    "batch_id",
    "window_end"
  ],
  "activities": [
    {
      "name": "lookup_watermark",
      "type": "Lookup",
      "policy": {
        "timeout": "0.00:05:00",
        "retry": 0
      },
      "typeProperties": {
        "source": {
          "type": "DelimitedTextSource",
          "storeSettings": {
            "type": "AzureBlobFSReadSettings"
          },
          "formatSettings": {
            "type": "DelimitedTextReadSettings",
            "compressionProperties": null
          }
        },
        "dataset": {
          "referenceName": "ds_landing_text",
          "type": "DatasetReference",
          "parameters": {
            "folder": "_control",
            "file": "lc_deals.watermark"
          }
        },
        "firstRowOnly": true
      }
    },
    {
      "name": "count_window",
      "type": "Lookup",
      "dependsOn": [
        {
          "activity": "lookup_watermark",
          "dependencyConditions": [
            "Succeeded"
          ]
        }
      ],
      "policy": {
        "timeout": "0.00:05:00",
        "retry": 0
      },
      "typeProperties": {
        "source": {
          "type": "PostgreSqlV2Source",
          "query": {
            "value": "SELECT count(*) AS n FROM lc_deals WHERE updated_at > '@{activity('lookup_watermark').output.firstRow.Prop_0}' AND updated_at <= '@{pipeline().parameters.window_end}'",
            "type": "Expression"
          }
        },
        "dataset": {
          "referenceName": "ds_tradebook",
          "type": "DatasetReference"
        },
        "firstRowOnly": true
      }
    },
    {
      "name": "copy_window",
      "type": "Copy",
      "dependsOn": [
        {
          "activity": "count_window",
          "dependencyConditions": [
            "Succeeded"
          ]
        }
      ],
      "policy": {
        "timeout": "0.00:05:00",
        "retry": 0
      },
      "typeProperties": {
        "source": {
          "type": "PostgreSqlV2Source",
          "query": {
            "value": "SELECT * FROM lc_deals WHERE updated_at > '@{activity('lookup_watermark').output.firstRow.Prop_0}' AND updated_at <= '@{pipeline().parameters.window_end}' ORDER BY lc_id",
            "type": "Expression"
          }
        },
        "sink": {
          "type": "DelimitedTextSink",
          "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
          },
          "formatSettings": {
            "type": "DelimitedTextWriteSettings",
            "fileExtension": ".csv"
          }
        }
      },
      "inputs": [
        {
          "referenceName": "ds_tradebook",
          "type": "DatasetReference"
        }
      ],
      "outputs": [
        {
          "referenceName": "ds_landing_csv",
          "type": "DatasetReference",
          "parameters": {
            "folder": {
              "value": "lc_deals/batch_id=@{pipeline().parameters.batch_id}",
              "type": "Expression"
            },
            "file": "part-00000.csv"
          }
        }
      ]
    },
    {
      "name": "g1",
      "type": "IfCondition",
      "dependsOn": [
        {
          "activity": "copy_window",
          "dependencyConditions": [
            "Succeeded"
          ]
        }
      ],
      "typeProperties": {
        "expression": {
          "value": "@equals(int(activity('count_window').output.firstRow.n), activity('copy_window').output.rowsCopied)",
          "type": "Expression"
        },
        "ifTrueActivities": [
          {
            "name": "seal",
            "type": "Copy",
            "dependsOn": [],
            "policy": {
              "timeout": "0.00:05:00",
              "retry": 0
            },
            "typeProperties": {
              "source": {
                "type": "PostgreSqlV2Source",
                "query": {
                  "value": "SELECT 1 AS sealed WHERE false",
                  "type": "Expression"
                }
              },
              "sink": {
                "type": "DelimitedTextSink",
                "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                },
                "formatSettings": {
                  "type": "DelimitedTextWriteSettings",
                  "fileExtension": ".csv"
                }
              }
            },
            "inputs": [
              {
                "referenceName": "ds_tradebook",
                "type": "DatasetReference"
              }
            ],
            "outputs": [
              {
                "referenceName": "ds_landing_text",
                "type": "DatasetReference",
                "parameters": {
                  "folder": {
                    "value": "lc_deals/batch_id=@{pipeline().parameters.batch_id}",
                    "type": "Expression"
                  },
                  "file": "_SUCCESS"
                }
              }
            ]
          },
          {
            "name": "commit_watermark",
            "type": "Copy",
            "dependsOn": [
              {
                "activity": "seal",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.00:05:00",
              "retry": 0
            },
            "typeProperties": {
              "source": {
                "type": "PostgreSqlV2Source",
                "query": {
                  "value": "SELECT '@{pipeline().parameters.window_end}' AS watermark",
                  "type": "Expression"
                }
              },
              "sink": {
                "type": "DelimitedTextSink",
                "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                },
                "formatSettings": {
                  "type": "DelimitedTextWriteSettings",
                  "fileExtension": ".csv"
                }
              }
            },
            "inputs": [
              {
                "referenceName": "ds_tradebook",
                "type": "DatasetReference"
              }
            ],
            "outputs": [
              {
                "referenceName": "ds_landing_text",
                "type": "DatasetReference",
                "parameters": {
                  "folder": "_control",
                  "file": "lc_deals.watermark"
                }
              }
            ]
          }
        ],
        "ifFalseActivities": [
          {
            "name": "g1_fail",
            "type": "Fail",
            "typeProperties": {
              "message": {
                "value": "G1 FAIL: batch @{pipeline().parameters.batch_id}: @{activity('count_window').output.firstRow.n} rows in the window, @{activity('copy_window').output.rowsCopied} landed",
                "type": "Expression"
              },
              "errorCode": "G1"
            }
          }
        ]
      }
    }
  ]
}
